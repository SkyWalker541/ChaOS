# plastron's build runs this (its package/tortos/tortos.mk): CC is its
# cross-compiler, and SYSROOT its staging directory, which holds the same SDL2
# and FFmpeg the device's system is built with, so what links is what runs.
BUILD := build
# Every device shares src/*.c; DEVICE picks the one device file built with it.
DEVICE ?= brick
SRC := $(wildcard src/*.c) src/device/$(DEVICE).c
# The updater's SHA-256, for System Update to check a download the same way
SRC += tools/tortos-update/sha256.c
CC ?= aarch64-linux-gnu-gcc

# TortOS's version, the Makefile's one number (not ChaOS's, which is
# CHAOS_VERSION): About read a ChaOS version beside "TortOS" while builds
# passed ChaOS's here (2.7.x to 2.8.0-test1)
VERSION ?= $(shell sed -n 's/^VERSION ?= //p' Makefile)
CHAOS_VERSION ?= $(shell cat CHAOS_VERSION 2>/dev/null || echo 0.0)
CFLAGS := -DTORTOS_VERSION='"$(VERSION)"' -DCHAOS_VERSION='"$(CHAOS_VERSION)"' -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -std=gnu11 \
          -I$(SYSROOT)/usr/include/SDL2 -D_GNU_SOURCE
# No undefined symbols allowed, in this code or in the libraries it links:
# SYSROOT has SDL and everything SDL needs, so the link checks that TortOS uses
# no function the system's libraries lack, and that those libraries resolve.
LDFLAGS := -L$(SYSROOT)/usr/lib -Wl,-rpath-link,$(SYSROOT)/usr/lib
LDLIBS := -lSDL2 -lSDL2_image -lSDL2_ttf -lsqlite3 -lz -lasound -lm

# The ScreenScraper developer pair, from the environment into a GENERATED
# HEADER rather than onto the compile line.
#
# -DSS_DEVPASS='"..."' would work and would put the password in an argument
# make echoes on every build, into the terminal and into any log the build is
# piped to. The header goes under $(BUILD), which is gitignored, is written
# with a 077 umask, and is replaced only when its contents change so an
# unchanged environment does not force a relink.
#
# AN UNSET ENVIRONMENT IS A SUPPORTED BUILD. Both come out empty, ss_have_dev()
# is false, and the launcher scrapes from libretro alone - so a stranger
# cloning this repository gets a launcher that works. The credentials are never
# committed. That keeps them out of public repositories, where they are
# harvested; it is no secret from anyone holding a built card (src/ss.h).
CREDS := $(BUILD)/ss_creds.h
CFLAGS += -I$(BUILD)
# src too, so a device file in src/device/ includes the shared headers by name
CFLAGS += -Isrc

.PHONY: creds
creds:
	@mkdir -p $(BUILD)
	@umask 077; { \
	  echo '/* Generated by the build from the environment. Not in the'; \
	  echo '   repository, and not a secret from anyone holding the card:'; \
	  echo '   see src/ss.h. */'; \
	  printf '#define SS_DEVID   "%s"\n' "$$(printf '%s' "$$SS_DEVID"   | sed 's/[\\"]/\\\\&/g')"; \
	  printf '#define SS_DEVPASS "%s"\n' "$$(printf '%s' "$$SS_DEVPASS" | sed 's/[\\"]/\\\\&/g')"; \
	} > $(CREDS).new
	@cmp -s $(CREDS).new $(CREDS) 2>/dev/null || mv -f $(CREDS).new $(CREDS)
	@rm -f $(CREDS).new

# The texts of the systems row's card, a generated header too (mk/notes.sh).
# Run every build, and the header replaced only when it changes.
NOTES := $(BUILD)/notes.h
.PHONY: FORCE
FORCE:
$(NOTES): FORCE
	@sh mk/notes.sh $@

# ChaOS: libchdr, for reading a .chd disc to hash it (src/rahash_disc.c), one
# file of someone else's C built on its own, without our warnings
# ChaOS: 7-Zip's C decoder, for .7z ROMs (lib/7z/sevenz.h), the same way
$(BUILD)/7z.o: lib/7z/chaos_7z.c lib/7z/sevenz.h
	mkdir -p $(BUILD)
	$(CC) -c -O2 -w -mcpu=cortex-a53 -o $@ $<

$(BUILD)/chd.o: lib/libchdr/chaos_chd.c
	mkdir -p $(BUILD)
	$(CC) -c -O2 -w -mcpu=cortex-a53 -DCHDR_SYSTEM_ZLIB -I$(SYSROOT)/usr/include -I$(SYSROOT)/include -Ilib/libchdr/include -o $@ $<

$(BUILD)/tortos.elf: $(SRC) $(CREDS) $(NOTES) $(wildcard src/*.h) $(BUILD)/chd.o $(BUILD)/7z.o
	mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SRC) $(BUILD)/chd.o $(BUILD)/7z.o $(LDLIBS)

# Muse, the audio player's engine: a second binary, not part of tortos.elf -
# SRC above is src/*.c, which does not descend into src/muse/. Linked against
# the FFmpeg and ALSA in SYSROOT.
MUSE_SRC := $(wildcard src/muse/*.c)
$(BUILD)/muse: $(MUSE_SRC) $(wildcard src/muse/*.h)
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -std=gnu11 \
	      -D_GNU_SOURCE -I$(SYSROOT)/usr/include $(LDFLAGS) -o $@ $(MUSE_SRC) \
	      -lavformat -lavcodec -lavfilter -lswresample -lavutil -lasound -lpthread

# The updater (tools/tortos-update/, TortOS#69): one static program, as it runs
# after the root it was started from is gone and no library is left to load.
# Installed on the root by plastron, not on the card, and started by init's
# ::restart: line. Unpacks a release's .img.xz with XZ Embedded, from
# vendor/xz-embedded (mk/fetch-vendor.sh); plastron passes its own mount of
# vendor/ as XZ_DIR. The device is picked at build time, as src/device/ is.
XZ_DIR ?= vendor/xz-embedded
UPDATE_SRC := $(wildcard tools/tortos-update/*.c)
XZ_SRC := $(addprefix $(XZ_DIR)/,xz_crc32.c xz_crc64.c xz_dec_stream.c xz_dec_lzma2.c)
UPDATE_DEVICE := $(if $(filter brick,$(DEVICE)),UPDATE_BRICK,UPDATE_PIXEL2)
$(BUILD)/tortos-update: $(UPDATE_SRC) $(wildcard tools/tortos-update/*.h) $(XZ_SRC)
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -std=gnu11 -D_GNU_SOURCE -static \
	      -D$(UPDATE_DEVICE) -DXZ_USE_CRC64 -I$(XZ_DIR) -o $@ $(UPDATE_SRC) $(XZ_SRC)

# ChaOS: the overlay over the player's own PICO-8, loaded into it with
# LD_PRELOAD by res/pico8/run.sh (see res/pico8/overlay.c). Uses the SDL
# PICO-8 has loaded, so it links to none; kept as dist/brick/pico8-overlay.so.
$(BUILD)/pico8-overlay.so: res/pico8/overlay.c
	mkdir -p $(BUILD)
	$(CC) -shared -fPIC -O2 -Wall -Wextra -I$(SYSROOT)/include/SDL2 -I$(SYSROOT)/include -D_REENTRANT \
	      -o $@ $< -ldl

# Registers a do-nothing media player with BlueZ so a headset's absolute
# volume is not dropped, and hands a headset's keys to Muse; see the file.
# Linked against SYSROOT's libdbus, whose arch header lives under lib.
$(BUILD)/btplayer: tools/btplayer.c
	mkdir -p $(BUILD)
	$(CC) -O2 -mcpu=cortex-a53 -Wall -Wextra -std=gnu11 \
	      -I$(SYSROOT)/usr/include/dbus-1.0 -I$(SYSROOT)/usr/lib/dbus-1.0/include \
	      $(LDFLAGS) -o $@ $< -ldbus-1
